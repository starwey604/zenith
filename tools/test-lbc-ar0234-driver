#!/usr/bin/env python3
"""Run Aura regressions and LBC 1080p120 checks against the real driver functions.

Uses the original vendor INI and reusable I/O mocks from luckfox-aura-teleop.
No board access; I2C, controls and runtime PM are mocked.
"""
import argparse
import importlib.util
from pathlib import Path
import re
import subprocess
import unittest


FULL_HD_MAIN = r'''
int main(int argc, char **argv) {
    struct ar0234 ar = {
        .decxin_profile = true, .fast_readout = true,
        .cur_mode = &ar0234_decxin_fast_modes[AR0234_DECXIN_1080P_MODE],
        .modes = ar0234_decxin_fast_modes,
        .num_modes = ARRAY_SIZE(ar0234_decxin_fast_modes),
        .lane_count_id = AR0234_LANE_COUNT_ID_4LANE
    };
    struct v4l2_subdev sd = { .ar = &ar };
    struct v4l2_fract interval;
    struct control vb = { .minimum = (int)ar0234_min_vblank(&ar, ar.cur_mode),
        .maximum = (int)(AR0234_FLL_MAX - ar.cur_mode->height),
        .val = (int)ar0234_default_vblank(ar.cur_mode) };
    struct control hb = { 0 }, exp = { 0 };
    ar.dev = &ar; ar.ctrl_handler.ar = &ar;
    ar.vblank = &vb; ar.hblank = &hb; ar.exposure = &exp;
    fail_at = argc > 1 ? (unsigned int)strtoul(argv[1], NULL, 10) : 0;
    control_failure = argc > 2 ? atoi(argv[2]) : false;
    ar0234_frame_interval(&ar, ar.cur_mode, vb.val, &interval);
    printf("MODE %u %u %u %u %u %u %u %u\n", ar.num_modes,
           ar.cur_mode->width, ar.cur_mode->height, ar.cur_mode->line_length,
           ar.cur_mode->vts_def, ar.cur_mode->exposure_def,
           interval.numerator, interval.denominator);
    if (argc > 3 && !strcmp(argv[3], "timing")) {
        struct v4l2_subdev_frame_interval fi = { .interval = { 1, 120 } };
        int ret = ar0234_s_frame_interval(&sd, &fi);
        printf("FPS120 %d %d %u %u\n", ret, vb.val, fi.interval.numerator, fi.interval.denominator);
        fi.interval = (struct v4l2_fract) { 1, 240 };
        ret = ar0234_s_frame_interval(&sd, &fi);
        printf("FPS240 %d %d\n", ret, vb.val);
        fi.interval = (struct v4l2_fract) { 1, 60 };
        ret = ar0234_s_frame_interval(&sd, &fi);
        printf("FPS60 %d %d %u %u\n", ret, vb.val, fi.interval.numerator, fi.interval.denominator);
        ret = ar0234_set_mode(&ar, ar.cur_mode);
        printf("SAME_MODE %d %d\n", ret, vb.val);
        ret = ar0234_set_mode(&ar, &ar0234_decxin_fast_modes[0]);
        printf("TO720 %d %d %d %d %d\n", ret, vb.minimum, vb.val, hb.def, exp.maximum);
        ret = ar0234_set_mode(&ar, &ar0234_decxin_fast_modes[AR0234_DECXIN_1080P_MODE]);
        printf("TO1080 %d %d %d %d %d\n", ret, vb.minimum, vb.val, hb.def, exp.maximum);
        return 0;
    }
    if (argc > 3 && !strcmp(argv[3], "selection")) {
        struct v4l2_subdev_selection sel = {
            .which = V4L2_SUBDEV_FORMAT_ACTIVE, .target = V4L2_SEL_TGT_CROP_BOUNDS
        };
        int ret = ar0234_get_selection(&sd, NULL, &sel);
        printf("BOUNDS %d %d %d %u %u\n", ret, sel.r.left, sel.r.top, sel.r.width, sel.r.height);
        sel.target = V4L2_SEL_TGT_CROP;
        ret = ar0234_get_selection(&sd, NULL, &sel);
        printf("CROP %d %d %d %u %u\n", ret, sel.r.left, sel.r.top, sel.r.width, sel.r.height);
        return 0;
    }
    int ret = ar0234_s_stream(&sd, 1);
    printf("RESULT %d %d %d\n", ret, ar.streaming, ar.pm_refs);
    if (!ret) {
        ret = ar0234_s_stream(&sd, 1);
        printf("REPEAT %d %d %d\n", ret, ar.streaming, ar.pm_refs);
        ret = ar0234_s_stream(&sd, 0);
        printf("STOP %d %d %d\n", ret, ar.streaming, ar.pm_refs);
    }
    return 0;
}
'''


class FullHDTests(unittest.TestCase):
    @classmethod
    def setUpClass(cls):
        # The preceding Aura suite generates this harness from the LBC source.
        source = (VENDOR.BUILD / 'profile_harness.c').read_text()
        source = source.replace('int main(int argc, char **argv)', 'int aura_main(int argc, char **argv)')
        harness = VENDOR.BUILD / 'full_hd_harness.c'
        harness.write_text(source + FULL_HD_MAIN)
        cls.binary = VENDOR.BUILD / 'full_hd_harness'
        subprocess.run(['cc', '-std=c11', '-Wall', '-Wextra', '-Werror', str(harness), '-o', str(cls.binary)], check=True)

    def run_mode(self, fail_at=0, controls_fail=0, action='stream'):
        output = subprocess.check_output([str(self.binary), str(fail_at), str(controls_fail), action], text=True)
        return [tuple([p[0]] + [int(x) for x in p[1:]]) for p in map(str.split, output.splitlines())]

    def oracle(self):
        section = VENDOR.INI.read_text().split('[1080P 60fps]', 1)[1].split('[720P 99.2fps]', 1)[0]
        expected = [('W', 0x301a, 1), ('D', 200), ('W', 0x3064, 0x1802)]
        # Vendor 1080p crop/calibration, reference 612-clock line, >=1ms ISP blank.
        overrides = {0x31ae: 0x0204, 0x300c: 612, 0x300a: 1223,
                     0x3012: 1028, 0x30ba: 0x7622}
        skip = False
        for line in section.splitlines():
            write = re.match(r'(0x[\da-fA-F]+)\s*,\s*(0x[\da-fA-F]+)', line)
            delay = re.match(r'DELAY\s*=\s*(\d+)', line)
            if write:
                address, value = int(write[1], 16), int(write[2], 16)
                if (address, value) == (0x3088, 0x81ba):
                    skip = True
                    continue
                if skip:
                    self.assertEqual((address, value), (0x3086, 0x3d02))
                    skip = False
                    continue
                expected.append(('W', address, overrides.get(address, value)))
            elif delay:
                expected.append(('D', int(delay[1])))
        self.assertFalse(skip)
        return expected

    def test_1080p_sequence_matches_original_vendor_geometry_and_calibration(self):
        events = self.run_mode()
        self.assertEqual(events[0], ('MODE', 2, 1920, 1080, 612, 1223, 1028, 2448 * 1228, 360000000))
        oracle = self.oracle()
        self.assertEqual(events[1], ('PM+',))
        self.assertEqual(events[2:2 + len(oracle)], oracle)
        self.assertIn(('REPEAT', 0, 1, 1), events)
        self.assertEqual(events[-1], ('STOP', 0, 0, 0))

    def test_frame_rate_limits_and_mode_switch_update_timing(self):
        events = self.run_mode(action='timing')[1:]
        self.assertEqual(events, [
            ('FPS120', 0, 148, 2448 * 1228, 360000000),
            ('FPS240', 0, 148),
            ('FPS60', 0, 1371, 2448 * 2451, 360000000),
            ('SAME_MODE', 0, 1371),
            ('TO720', 0, 506, 762, 1168, 1476),
            ('TO1080', 0, 148, 148, 528, 1222),
        ])

    def test_1080p_default_leaves_at_least_one_ms_for_online_isp(self):
        mode = self.run_mode()[0]
        _, _, _, height, line_length, vts, _, numerator, denominator = mode
        self.assertGreaterEqual((vts + 5 - height) * line_length * 1000, 90000000)
        self.assertGreater(denominator / numerator, 119.5)
        self.assertLessEqual(denominator / numerator, 120)

    def test_cif_crop_bounds_are_1080p_not_native_coordinates(self):
        self.assertEqual(self.run_mode(action='selection')[1:], [
            ('BOUNDS', 0, 0, 0, 1920, 1080), ('CROP', 0, 8, 68, 1920, 1080),
        ])

    def test_each_i2c_failure_aborts_and_balances_runtime_pm(self):
        oracle = self.oracle()
        write_count = sum(e[0] == 'W' for e in oracle)
        for fail_at in range(1, write_count + 1):
            with self.subTest(fail_at=fail_at):
                events = self.run_mode(fail_at=fail_at)
                count = 0
                consumed = []
                for event in oracle:
                    consumed.append(event)
                    count += event[0] == 'W'
                    if count == fail_at:
                        break
                self.assertEqual(events[2:2 + len(consumed)], consumed)
                self.assertEqual(events[2 + len(consumed):], [
                    ('W', 0x301a, 0x2058), ('PM-',), ('RESULT', -5, 0, 0),
                ])

    def test_control_failure_stops_1080p_stream(self):
        self.assertEqual(self.run_mode(controls_fail=1)[-4:], [
            ('C',), ('W', 0x301a, 0x2058), ('PM-',), ('RESULT', -5, 0, 0),
        ])


if __name__ == '__main__':
    root = Path(__file__).resolve().parents[1]
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--kernel', type=Path, default=root.parent / 'lbc_kernel')
    parser.add_argument('--aura-repo', type=Path, default=root.parent / 'luckfox-aura-teleop')
    parser.add_argument('--build-dir', type=Path, default=root / 'out/ar0234-driver-check')
    args = parser.parse_args()
    spec = importlib.util.spec_from_file_location('aura_vendor_tests', args.aura_repo / 'tests/ar0234/test_vendor_profile.py')
    VENDOR = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(VENDOR)
    VENDOR.DRIVER = args.kernel.resolve() / 'drivers/media/i2c/ar0234.c'
    VENDOR.HEADER = VENDOR.DRIVER.with_name('ar0234-decxin-3478v1.h')
    VENDOR.BUILD = args.build_dir.resolve()
    suite = unittest.TestSuite([
        unittest.defaultTestLoader.loadTestsFromModule(VENDOR),
        unittest.defaultTestLoader.loadTestsFromTestCase(FullHDTests),
    ])
    raise SystemExit(not unittest.TextTestRunner(verbosity=2).run(suite).wasSuccessful())
