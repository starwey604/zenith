{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_FLAGS_RELWITHDEBINFO": "-O3 -g -DNDEBUG -flto=thin",
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "-O3 -g -DNDEBUG -flto=thin",
        "CMAKE_INSTALL_PREFIX": "/usr",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "OFF",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_EXE_LINKER_FLAGS": "-fuse-ld=lld -flto=thin -Wl,--thinlto-jobs=2",
        "CMAKE_SHARED_LINKER_FLAGS": "-fuse-ld=lld -flto=thin -Wl,--thinlto-jobs=2",
        "CMAKE_MODULE_LINKER_FLAGS": "-fuse-ld=lld -flto=thin -Wl,--thinlto-jobs=2"
      }
    },
    {
      "name": "native",
      "inherits": "base",
      "displayName": "Host development",
      "binaryDir": "${sourceDir}/../out/runtime/native/build-llvm",
      "cacheVariables": {
        "ZENITH_PLATFORM": "native",
        "CMAKE_C_FLAGS": "-march=native -mtune=native",
        "CMAKE_CXX_FLAGS": "-march=native -mtune=native -stdlib=libc++",
        "CMAKE_AR": "llvm-ar",
        "CMAKE_RANLIB": "llvm-ranlib"
      }
    },
    {
      "name": "lbc3",
      "inherits": "base",
      "displayName": "LubanCat 3 / Clang + libc++ / AArch64",
      "binaryDir": "${sourceDir}/../out/runtime/lbc3/build-llvm",
      "toolchainFile": "${sourceDir}/cmake/toolchains/lbc3.cmake",
      "cacheVariables": {
        "ZENITH_PLATFORM": "lbc3"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "native",
      "configurePreset": "native"
    },
    {
      "name": "lbc3",
      "configurePreset": "lbc3"
    }
  ],
  "testPresets": [
    {
      "name": "native",
      "configurePreset": "native",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
