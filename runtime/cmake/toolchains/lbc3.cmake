# Clang uses the repository's Buildroot sysroot and GCC support files.
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(CMAKE_C_COMPILER clang)
set(CMAKE_CXX_COMPILER clang++)
set(CMAKE_ASM_COMPILER clang)
set(CMAKE_C_COMPILER_TARGET aarch64-buildroot-linux-gnu)
set(CMAKE_CXX_COMPILER_TARGET aarch64-buildroot-linux-gnu)
set(CMAKE_ASM_COMPILER_TARGET aarch64-buildroot-linux-gnu)

foreach(_variable LBC_BUILDROOT_HOST_DIR ZENITH_LLVM_RUNTIME_PREFIX ZENITH_BUILD_LLVM_RUNTIMES)
    if(NOT DEFINED ${_variable} AND DEFINED ENV{${_variable}})
        set(${_variable} "$ENV{${_variable}}")
    endif()
    list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES ${_variable})
endforeach()
if(NOT LBC_BUILDROOT_HOST_DIR)
    message(FATAL_ERROR "Run tools/runtime-build lbc3 to prepare the repository SDK")
endif()
set(LBC_BUILDROOT_HOST_DIR "${LBC_BUILDROOT_HOST_DIR}" CACHE PATH "Extracted Buildroot SDK")
set(CMAKE_SYSROOT "${LBC_BUILDROOT_HOST_DIR}/aarch64-buildroot-linux-gnu/sysroot")
if(NOT EXISTS "${CMAKE_SYSROOT}/usr/include/stdio.h")
    message(FATAL_ERROR "Incomplete Buildroot sysroot: ${CMAKE_SYSROOT}")
endif()
set(CMAKE_C_COMPILER_EXTERNAL_TOOLCHAIN "${LBC_BUILDROOT_HOST_DIR}")
set(CMAKE_CXX_COMPILER_EXTERNAL_TOOLCHAIN "${LBC_BUILDROOT_HOST_DIR}")
set(CMAKE_C_FLAGS_INIT "-march=armv8-a -mtune=cortex-a72")
set(CMAKE_CXX_FLAGS_INIT "-march=armv8-a -mtune=cortex-a72")
set(CMAKE_ASM_FLAGS_INIT "--target=aarch64-buildroot-linux-gnu -march=armv8-a")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-fuse-ld=lld")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "-fuse-ld=lld")
set(CMAKE_MODULE_LINKER_FLAGS_INIT "-fuse-ld=lld")
find_program(CMAKE_AR NAMES llvm-ar REQUIRED)
find_program(CMAKE_RANLIB NAMES llvm-ranlib REQUIRED)
find_program(CMAKE_NM NAMES llvm-nm REQUIRED)
find_program(CMAKE_READELF NAMES llvm-readelf REQUIRED)

if(NOT ZENITH_BUILD_LLVM_RUNTIMES)
    if(NOT EXISTS "${ZENITH_LLVM_RUNTIME_PREFIX}/include/c++/v1/__config")
        message(FATAL_ERROR "Missing target libc++; use tools/runtime-build lbc3")
    endif()
    set(ZENITH_LLVM_RUNTIME_PREFIX "${ZENITH_LLVM_RUNTIME_PREFIX}" CACHE PATH "Target LLVM runtimes")
    string(APPEND CMAKE_CXX_FLAGS_INIT
        " -nostdinc++ -isystem \"${ZENITH_LLVM_RUNTIME_PREFIX}/include/c++/v1\"")
    # Keep glibc dynamic, while bundling the C++ runtime in the executable.
    foreach(_kind EXE SHARED MODULE)
        string(APPEND CMAKE_${_kind}_LINKER_FLAGS_INIT " -nostdlib++")
    endforeach()
    set(CMAKE_CXX_STANDARD_LIBRARIES
        "-stdlib=libc++ -nostdlib++ \"${ZENITH_LLVM_RUNTIME_PREFIX}/lib/libc++.a\" \"${ZENITH_LLVM_RUNTIME_PREFIX}/lib/libc++abi.a\" \"${ZENITH_LLVM_RUNTIME_PREFIX}/lib/libunwind.a\""
        CACHE STRING "Target C++ runtime libraries" FORCE)
endif()

set(CMAKE_FIND_ROOT_PATH "${CMAKE_SYSROOT};${ZENITH_LLVM_RUNTIME_PREFIX}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(ENV{PKG_CONFIG_SYSROOT_DIR} "${CMAKE_SYSROOT}")
set(ENV{PKG_CONFIG_LIBDIR} "${CMAKE_SYSROOT}/usr/lib/pkgconfig:${CMAKE_SYSROOT}/usr/share/pkgconfig")
set(ENV{PKG_CONFIG_PATH} "")
