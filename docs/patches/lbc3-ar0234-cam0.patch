index 000000000..b6f88bb99
--- /dev/null
+++ b/arch/arm64/boot/dts/rockchip/rk3576-lubancat-3-ar0234-cam0.dtsi
@@ -0,0 +1,126 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * DECXIN-3478V1 AR0234 on CAM0 through the four-layer B2B-to-22P adapter.
+ * The adapter converts CAM0's 5 V to 3.3 V. The module provides its own
+ * sensor rails, reset and 24 MHz oscillator; FFC pins 5 and 6 are NC.
+ * Use an opposite-contact FFC with connector pin 1 wired to pin 1.
+ */
+
+/ {
+	ar0234_cam0_osc: ar0234-cam0-osc {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <24000000>;
+		clock-output-names = "ar0234-cam0-module-osc";
+	};
+
+	ar0234_cam0_3v3: ar0234-cam0-3v3 {
+		compatible = "regulator-fixed";
+		regulator-name = "ar0234_cam0_3v3";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		regulator-always-on;
+		regulator-boot-on;
+		vin-supply = <&vcc_sys>;
+	};
+};
+
+/* CAM0 shares I2C3 with the v2 board's RTC at 0x51. */
+&i2c3 {
+	status = "okay";
+	clock-frequency = <100000>;
+	pinctrl-names = "default";
+	pinctrl-0 = <&i2c3m0_xfer>;
+
+	ar0234_cam0: camera@10 {
+		compatible = "decxin,3478v1-1080p120", "decxin,3478v1-fastreadout",
+			     "decxin,3478v1", "onnn,ar0234cs";
+		reg = <0x10>;
+		status = "okay";
+		clocks = <&ar0234_cam0_osc>;
+		clock-names = "xvclk";
+		vdd-supply = <&ar0234_cam0_3v3>;
+		rockchip,camera-module-index = <0>;
+		rockchip,camera-module-facing = "back";
+		rockchip,camera-module-name = "DECXIN-3478V1";
+		rockchip,camera-module-lens-name = "DECXIN-123deg";
+
+		port {
+			ar0234_cam0_out: endpoint {
+				remote-endpoint = <&dcphy0_in_ar0234>;
+				clock-lanes = <0>;
+				data-lanes = <1 2 3 4>;
+				link-frequencies = /bits/ 64 <450000000>;
+				/* Continuous clock, 900 Mbit/s per lane. */
+			};
+		};
+	};
+};
+
+/* Fixed-focus module: the stock CAM0 lens controller is not populated. */
+&dw9714_0 {
+	status = "disabled";
+};
+
+&csi2_dcphy0 {
+	status = "okay";
+	ports {
+		port@0 {
+			dcphy0_in_ar0234: endpoint@9 {
+				reg = <9>;
+				remote-endpoint = <&ar0234_cam0_out>;
+				clock-lanes = <0>;
+				data-lanes = <1 2 3 4>;
+			};
+		};
+	};
+};
+
+/* Reuse the board's CAM0 -> CSI0 -> CIF -> ISP0 -> VPSS0 graph. */
+&mipi0_csi2 {
+	status = "okay";
+};
+
+&rkcif {
+	status = "okay";
+};
+
+&rkcif_mmu {
+	status = "okay";
+};
+
+&rkcif_mipi_lvds {
+	status = "okay";
+};
+
+&rkcif_mipi_lvds_sditf {
+	status = "okay";
+};
+
+&rkisp {
+	status = "okay";
+};
+
+&rkisp_mmu {
+	status = "okay";
+};
+
+&rkisp_vir0 {
+	status = "okay";
+};
+
+&rkisp_vir0_sditf {
+	status = "okay";
+};
+
+&rkvpss {
+	status = "okay";
+};
+
+&rkvpss_mmu {
+	status = "okay";
+};
+
+&rkvpss_vir0 {
+	status = "okay";
+};
