{
  "name": "zenith-mechanical-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "build": "npm run prepare:assets && tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173 --strictPort",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:browser": "playwright test",
    "prepare:assets": "node --experimental-strip-types scripts/prepare-assets.ts",
    "predev": "npm run prepare:assets",
    "check:dist": "node --experimental-strip-types scripts/check-dist.ts",
    "deploy:check": "wrangler deploy --dry-run --outdir=.wrangler/dry-run",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/three": "0.186.0",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "wrangler": "4.156.0"
  }
}
