index ae3bb067..72a2b3ca 100644
--- a/configs/rockchip_rk3568_lubancat_defconfig
+++ b/configs/rockchip_rk3568_lubancat_defconfig
@@ -28,7 +28,8 @@ BR2_PACKAGE_OPENSSH=y
 # BR2_PACKAGE_RKSCRIPT_IODOMAIN_NOTICE is not set
