*.pdf filter=lfs diff=lfs merge=lfs -text
mechanical/**/*.FCStd filter=lfs diff=lfs merge=lfs -text
mechanical/**/*.stl filter=lfs diff=lfs merge=lfs -text
runtime/toolchains/**/*.tar.gz filter=lfs diff=lfs merge=lfs -text
runtime/third_party/sources/*.tar.xz filter=lfs diff=lfs merge=lfs -text
mechanical/hero_head/magazine_study/assets/reference_meshes.json filter=lfs diff=lfs merge=lfs -text
mechanical/hero_head/reports/*.csv text eol=lf
# FreeCAD downloads moved with the frontend; CI fetches this subset only.
frontend/public/downloads/*.FCStd filter=lfs diff=lfs merge=lfs -text
# Preserve factory CAD bytes and avoid treating STEP geometry as prose diffs.
*.[sS][tT][eE][pP] binary
*.[sS][tT][pP] binary
mechanical/hero_head/**/*.csv text eol=lf
# Unified diff context carries its own indentation and blank-line prefixes.
docs/patches/*.patch -whitespace
