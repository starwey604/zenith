{
  "name": "zenith-comments",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=26" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "dev": "wrangler dev --port 5190",
    "check": "wrangler deploy --dry-run --outdir .worker-build",
    "deploy": "wrangler deploy",
    "admin:password": "wrangler secret put INITIAL_ADMIN_PASSWORD",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": { "wrangler": "4.156.0" }
}
